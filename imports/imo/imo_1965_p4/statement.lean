theorem candidate (x₁ x₂ x₃ x₄ : ℝ) :
    (x₁ + x₂ * x₃ * x₄ = 2 ∧ x₂ + x₁ * x₃ * x₄ = 2 ∧
      x₃ + x₁ * x₂ * x₄ = 2 ∧ x₄ + x₁ * x₂ * x₃ = 2)
      ↔
    ((x₁ = 1 ∧ x₂ = 1 ∧ x₃ = 1 ∧ x₄ = 1) ∨
     (x₁ = 3 ∧ x₂ = -1 ∧ x₃ = -1 ∧ x₄ = -1) ∨
     (x₁ = -1 ∧ x₂ = 3 ∧ x₃ = -1 ∧ x₄ = -1) ∨
     (x₁ = -1 ∧ x₂ = -1 ∧ x₃ = 3 ∧ x₄ = -1) ∨
     (x₁ = -1 ∧ x₂ = -1 ∧ x₃ = -1 ∧ x₄ = 3)) :=
