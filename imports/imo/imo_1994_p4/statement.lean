/-- IMO 1994, Problem 4. -/
theorem candidate (m n : ℕ) :
    (0 < m ∧ 0 < n ∧ (m * n - 1) ∣ (n ^ 3 + 1)) ↔
      (m, n) = (1, 2) ∨ (m, n) = (2, 1) ∨
      (m, n) = (1, 3) ∨ (m, n) = (3, 1) ∨
      (m, n) = (2, 2) ∨ (m, n) = (2, 5) ∨
      (m, n) = (5, 2) ∨ (m, n) = (3, 5) ∨
      (m, n) = (5, 3) :=
